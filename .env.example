# Copy to .env.local and fill in from your Supabase project (Settings > API).
# Without these the app still works in "this device only" mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Workers preview (`npm run preview`): copy the same two lines to `.dev.vars`
# (see `.dev.vars.example`). Set them in the Cloudflare dashboard for production deploys.
